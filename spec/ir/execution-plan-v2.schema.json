{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dictum.invalid/spec/ir/execution-plan-v2.schema.json",
  "title": "ExecutionPlan v2",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "resolution_id",
    "decision_id",
    "action_id",
    "context_id",
    "catalog",
    "policy",
    "effect",
    "scope",
    "target_bindings",
    "action",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "request_id": {
      "$ref": "nlu-proposal-v2.schema.json#/$defs/opaque_id"
    },
    "resolution_id": {
      "$ref": "nlu-proposal-v2.schema.json#/$defs/opaque_id"
    },
    "decision_id": {
      "$ref": "nlu-proposal-v2.schema.json#/$defs/opaque_id"
    },
    "action_id": {
      "$ref": "nlu-proposal-v2.schema.json#/$defs/opaque_id"
    },
    "context_id": {
      "$ref": "resolved-ir-v2.schema.json#/$defs/sha256"
    },
    "catalog": {
      "$ref": "resolved-ir-v2.schema.json#/$defs/versioned_identity"
    },
    "policy": {
      "$ref": "resolved-ir-v2.schema.json#/$defs/versioned_identity"
    },
    "effect": {
      "$ref": "policy-decision-v2.schema.json#/$defs/effect"
    },
    "scope": {
      "$ref": "policy-decision-v2.schema.json#/$defs/scope"
    },
    "target_bindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "slot",
          "binding_id"
        ],
        "properties": {
          "slot": {
            "$ref": "nlu-proposal-v2.schema.json#/$defs/slot_name"
          },
          "binding_id": {
            "$ref": "nlu-proposal-v2.schema.json#/$defs/opaque_id"
          }
        },
        "additionalProperties": false
      }
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "digest": {
      "$ref": "resolved-ir-v2.schema.json#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "structured-proposal"
        },
        "operation": {
          "$ref": "#/$defs/native"
        }
      },
      "additionalProperties": false
    },
    "native": {
      "type": "object",
      "required": [
        "kind",
        "handler",
        "input_slots"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "native"
        },
        "handler": {
          "$ref": "nlu-proposal-v2.schema.json#/$defs/intent_id"
        },
        "input_slots": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "nlu-proposal-v2.schema.json#/$defs/slot_name"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
