{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dictum.invalid/spec/model-pack/manifest-v1.schema.json",
  "title": "DCTM detached bundle manifest v1 — data contract, not signature verification",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "role": {
      "enum": [
        "release-model-pack",
        "synthetic-test-only"
      ]
    },
    "publisher_key_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.-]{2,63}(?![\\s\\S])"
    },
    "release_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "model_version": {
      "$ref": "#/$defs/version"
    },
    "pack": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "length": {
          "type": "integer",
          "minimum": 32,
          "maximum": 134217728
        },
        "major": {
          "const": 1,
          "type": "integer"
        },
        "minor": {
          "const": 0,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "length",
        "major",
        "minor"
      ],
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "id",
        "profile_version"
      ],
      "additionalProperties": false
    },
    "tokenizer": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "length": {
          "type": "integer",
          "minimum": 8,
          "maximum": 10485760
        },
        "kind": {
          "const": 1,
          "type": "integer"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "sha256",
        "length",
        "kind",
        "version"
      ],
      "additionalProperties": false
    },
    "catalog": {
      "$ref": "#/$defs/artifact"
    },
    "policy": {
      "$ref": "#/$defs/artifact"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "platform": {
          "const": "debian-13"
        },
        "arch": {
          "const": "x86-64"
        },
        "runtime_min": {
          "$ref": "#/$defs/version"
        },
        "runtime_max": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "platform",
        "arch",
        "runtime_min",
        "runtime_max"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "role",
    "publisher_key_id",
    "release_sequence",
    "model_version",
    "pack",
    "architecture",
    "tokenizer",
    "catalog",
    "policy",
    "compatibility"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "version": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "patch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "major",
        "minor",
        "patch"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "sha256",
        "length",
        "version"
      ],
      "additionalProperties": false
    }
  }
}
